<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/spirit_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/spirit_mod_letter"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/spirit_icon_tile"
        android:gravity="center"
        android:textColor="@color/spirit_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/spirit_mod_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/spirit_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spirit_mod_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/spirit_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/spirit_mod_switch"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="8dp" />

    <TextView
        android:id="@+id/spirit_mod_info"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/spirit_card_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="i"
        android:textColor="@color/spirit_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/spirit_mod_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/spirit_card_bg"
        android:clickable="true"
        android:contentDescription="@string/spirit_browse_delete"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_px_trash"
        android:tint="#FF6B5E" />
</LinearLayout>
