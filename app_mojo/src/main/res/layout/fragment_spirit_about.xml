<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/spirit_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/spirit_back"
            android:padding="10dp"
            android:src="@drawable/ic_spirit_back"
            android:tint="@color/spirit_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/spirit_about_title"
            android:textColor="@color/spirit_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/spirit_card_bg"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:src="@mipmap/ic_spirit" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.18"
            android:text="@string/spirit_brand"
            android:textColor="@color/spirit_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spirit_about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:textColor="@color/spirit_text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/spirit_about_discord"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/spirit_button_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="30dp"
    android:paddingEnd="30dp"
            android:text="@string/spirit_about_discord"
            android:textColor="@color/spirit_on_lime"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/spirit_card_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spirit_about_made"
            android:textColor="@color/spirit_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/spirit_about_made_sub"
            android:textColor="@color/spirit_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/spirit_card_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spirit_about_oss"
            android:textColor="@color/spirit_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/spirit_about_oss_sub"
            android:textColor="@color/spirit_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/spirit_card_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spirit_about_legal"
            android:textColor="@color/spirit_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/spirit_about_legal_sub"
            android:textColor="@color/spirit_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/spirit_about_license"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/spirit_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/spirit_about_license"
            android:textColor="@color/spirit_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spirit_about_source"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/spirit_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/spirit_about_source"
            android:textColor="@color/spirit_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
