<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/spirit_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/spirit_back"
            android:padding="10dp"
            android:src="@drawable/ic_spirit_back"
            android:tint="@color/spirit_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/spirit_browse_title"
            android:textColor="@color/spirit_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/spirit_tab_mods"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/spirit_badge_fill"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
    android:paddingEnd="16dp"
                android:paddingTop="9dp"
    android:paddingBottom="9dp"
                android:text="@string/spirit_tab_mods"
                android:textColor="@color/spirit_on_lime"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/spirit_tab_packs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/spirit_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
    android:paddingEnd="16dp"
                android:paddingTop="9dp"
    android:paddingBottom="9dp"
                android:text="@string/spirit_tab_packs"
                android:textColor="@color/spirit_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/spirit_tab_shaders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/spirit_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
    android:paddingEnd="16dp"
                android:paddingTop="9dp"
    android:paddingBottom="9dp"
                android:text="@string/spirit_tab_shaders"
                android:textColor="@color/spirit_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/spirit_tab_worlds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/spirit_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
    android:paddingEnd="16dp"
                android:paddingTop="9dp"
    android:paddingBottom="9dp"
                android:text="@string/spirit_tab_worlds"
                android:textColor="@color/spirit_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/spirit_browse_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/spirit_input_bg"
        android:clickable="true"
        android:drawableStart="@drawable/ic_spirit_search"
        android:drawablePadding="10dp"
        app:drawableTint="@color/spirit_text_dim"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:paddingStart="14dp"
    android:paddingEnd="14dp"
        android:text="@string/spirit_browse_search"
        android:textColor="@color/spirit_text_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/spirit_browse_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/spirit_browse_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
    android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/spirit_browse_empty"
        android:textColor="@color/spirit_text_dim"
        android:textSize="14sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/spirit_dashed_bg"
        android:padding="14dp"
        android:text="@string/spirit_browse_note"
        android:textColor="@color/spirit_text_dim"
        android:textSize="12sp" />
</LinearLayout>
</ScrollView>
