<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
    android:paddingEnd="10dp"
            android:paddingBottom="16dp">

            <!-- Hero card: user's skin art, profile, play -->
            <FrameLayout
                android:id="@+id/spirit_hero_card"
                android:layout_width="match_parent"
                android:layout_height="310dp"
                android:layout_margin="6dp"
                android:background="@drawable/spirit_hero_bg"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/spirit_hero_skin"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/spirit_hero_fade" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/spirit_ready_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spirit_ready_to_play"
                        android:textColor="@color/spirit_lime"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.kdt.mcgui.mcVersionSpinner
                        android:id="@+id/mc_version_spinner"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_52sdp"
                        android:background="@android:color/transparent"
                        android:textColor="@color/spirit_text"
                        android:textStyle="bold"
                        android:drawableEnd="@drawable/spinner_arrow"
                        app:drawableEndSize="@dimen/padding_heavy"
                        app:drawableStartIntegerScaling="true"
                        app:drawableStartSize="@dimen/_36sdp"
                        app:drawableEndPadding="@dimen/_1sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/spirit_ready_label" />

                    <TextView
                        android:id="@+id/spirit_hero_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="17dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/spirit_text_dim"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/mc_version_spinner" />

                    <LinearLayout
                        android:id="@+id/spirit_hero_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="17dp"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/spirit_hero_subtitle" />

                    <com.kdt.mcgui.MineButton
                        android:id="@+id/play_button"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="10dp"
                        android:textAllCaps="true"
                        android:text="@string/main_play"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/edit_profile_button" />

                    <ImageButton
                        android:id="@+id/edit_profile_button"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/spirit_outline_bg"
                        android:src="@drawable/ic_px_edit"
                        android:padding="14dp"
                        android:tint="@color/spirit_lime"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <FrameLayout android:id="@+id/custom_control_button" android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1"
        android:layout_margin="6dp" android:background="@drawable/spirit_card_bg" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="bottom" android:padding="14dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_px_gamepad"
                android:tint="@color/spirit_lime" android:layout_marginBottom="8dp" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mcl_option_customcontrol"
                android:textColor="@color/spirit_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/spirit_cc_sub"
                android:textColor="@color/spirit_text_dim" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/open_files_button" android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1"
        android:layout_margin="6dp" android:background="@drawable/spirit_card_bg" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="bottom" android:padding="14dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_px_folder"
                android:tint="@color/spirit_lime" android:layout_marginBottom="8dp" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mcl_button_open_directory"
                android:textColor="@color/spirit_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/spirit_dir_sub"
                android:textColor="@color/spirit_text_dim" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <FrameLayout android:id="@+id/spirit_wardrobe_button" android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1"
        android:layout_margin="6dp" android:background="@drawable/spirit_card_bg" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="bottom" android:padding="14dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_spirit_wardrobe"
                android:tint="@color/spirit_lime" android:layout_marginBottom="8dp" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/spirit_wardrobe"
                android:textColor="@color/spirit_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/spirit_wardrobe_sub"
                android:textColor="@color/spirit_text_dim" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/spirit_browse_button" android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1"
        android:layout_margin="6dp" android:background="@drawable/spirit_card_bg" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="bottom" android:padding="14dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_spirit_browse"
                android:tint="@color/spirit_lime" android:layout_marginBottom="8dp" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/spirit_browse"
                android:textColor="@color/spirit_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/spirit_browse_sub"
                android:textColor="@color/spirit_text_dim" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/install_jar_button" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
        android:layout_margin="6dp" android:background="@drawable/spirit_card_bg" android:clickable="true" android:focusable="true"
        android:gravity="center" android:text="@string/main_install_jar_file" android:textColor="@color/spirit_text" android:textSize="14sp" />
    <TextView android:id="@+id/share_logs_button" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
        android:layout_margin="6dp" android:background="@drawable/spirit_card_bg" android:clickable="true" android:focusable="true"
        android:gravity="center" android:text="@string/main_share_logs" android:textColor="@color/spirit_text" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/news_button" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
        android:layout_margin="6dp" android:background="@drawable/spirit_card_bg" android:clickable="true" android:focusable="true"
        android:gravity="center" android:text="@string/mcl_tab_wiki" android:textColor="@color/spirit_text" android:textSize="14sp" />
    <TextView android:id="@+id/social_media_button" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
        android:layout_margin="6dp" android:background="@drawable/spirit_card_bg" android:clickable="true" android:focusable="true"
        android:gravity="center" android:text="@string/mcl_button_social_media" android:textColor="@color/spirit_text" android:textSize="14sp" />
    </LinearLayout>

            <TextView
                android:id="@+id/create_instance_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_margin="6dp"
                android:background="@drawable/spirit_outline_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:drawableStart="@drawable/ic_add"
                android:drawablePadding="10dp"
                android:paddingStart="40dp"
    android:paddingEnd="40dp"
                android:text="@string/create_instance"
                android:textColor="@color/spirit_lime"
                android:textSize="15sp"
                android:textStyle="bold"
                app:drawableTint="@color/spirit_lime" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
