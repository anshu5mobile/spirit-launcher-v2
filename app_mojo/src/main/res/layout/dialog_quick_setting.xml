<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edit_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/padding_moderate"
    android:paddingEnd="@dimen/padding_moderate"
    android:paddingTop="2dp"
    android:paddingBottom="@dimen/padding_moderate">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/spirit_card_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/spirit_qs_section_controls"
            android:textAllCaps="true"
            android:textColor="@color/spirit_lime"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Instant control layout switching -->
        <LinearLayout
            android:id="@+id/spirit_switch_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/spirit_card_selected_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_spirit_swap"
                android:tint="@color/spirit_lime" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spirit_switch_control"
                    android:textColor="@color/spirit_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spirit_switch_control_sub"
                    android:textColor="@color/spirit_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/spirit_control_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/spirit_text_dim"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/spirit_control_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/spirit_switch_show_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/spirit_qs_show_controls"
            android:textColor="@color/spirit_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonTransparency_textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="@string/preference_button_transparency"
                android:textColor="@color/spirit_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/buttonTransparency_textView_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textColor="@color/spirit_lime"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.kdt.CustomSeekbar
            android:id="@+id/buttonTransparency_seekBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:min="0"
            android:max="100"
            app:seekBarIncrement="5"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/spirit_buttonsize_textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="@string/spirit_qs_button_size"
                android:textColor="@color/spirit_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/spirit_buttonsize_textView_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textColor="@color/spirit_lime"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.kdt.CustomSeekbar
            android:id="@+id/spirit_buttonsize_seekbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:min="@integer/button_scale_seekbar_min"
            android:max="@integer/button_scale_seekbar_max"
            app:seekBarIncrement="@integer/button_scale_seekbar_increment"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/spirit_card_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/spirit_qs_section_display"
            android:textAllCaps="true"
            android:textColor="@color/spirit_lime"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editResolution_textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="@string/mcl_setting_title_resolution_scaler"
                android:textColor="@color/spirit_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/editResolution_textView_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textColor="@color/spirit_lime"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.kdt.CustomSeekbar
            android:id="@+id/editResolution_seekbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:min="@integer/resolution_seekbar_min"
            app:seekBarIncrement="@integer/resolution_seekbar_increment"
            />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/spirit_switch_fps_boost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/spirit_fps_boost"
            android:textColor="@color/spirit_text"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/spirit_switch_live_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/spirit_live_stats"
            android:textColor="@color/spirit_text"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/spirit_switch_sustained"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/spirit_qs_sustained"
            android:textColor="@color/spirit_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/spirit_card_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/spirit_qs_section_mouse"
            android:textAllCaps="true"
            android:textColor="@color/spirit_lime"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editMouseSpeed_textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="@string/mcl_setting_title_mousespeed"
                android:textColor="@color/spirit_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/editMouseSpeed_textView_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textColor="@color/spirit_lime"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.kdt.CustomSeekbar
            android:id="@+id/editMouseSpeed_seekbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:min="@integer/mouse_speed_seekbar_min"
            android:max="@integer/mouse_speed_seekbar_max"
            app:seekBarIncrement="@integer/mouse_speed_seekbar_increment"
            />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/checkboxGesture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/mcl_disable_gestures"
            android:textColor="@color/spirit_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editGestureDelay_textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="@string/mcl_setting_title_longpresstrigger"
                android:textColor="@color/spirit_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/editGestureDelay_textView_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textColor="@color/spirit_lime"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.kdt.CustomSeekbar
            android:id="@+id/editGestureDelay_seekbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:min="@integer/gesture_delay_seekbar_min"
            android:max="@integer/gesture_delay_seekbar_max"
            app:seekBarIncrement="@integer/gesture_delay_seekbar_increment"
            />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/checkboxHotbarDrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="Hold hotbar slot to drop item"
            android:textColor="@color/spirit_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editHotbarDropDelay_textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="Hotbar drop delay"
                android:textColor="@color/spirit_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/editHotbarDropDelay_textView_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textColor="@color/spirit_lime"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.kdt.CustomSeekbar
            android:id="@+id/editHotbarDropDelay_seekbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:min="300"
            android:max="2000"
            app:seekBarIncrement="100"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/spirit_qs_gyro_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/spirit_card_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/spirit_qs_section_gyro"
            android:textAllCaps="true"
            android:textColor="@color/spirit_lime"
            android:textSize="11sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/checkboxGyro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/preference_enable_gyro_title"
            android:textColor="@color/spirit_text"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/checkboxGyroX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/preference_gyro_invert_x_axis"
            android:textColor="@color/spirit_text"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/checkboxGyroY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/preference_gyro_invert_y_axis"
            android:textColor="@color/spirit_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editGyro_textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="@string/preference_gyro_sensitivity_title"
                android:textColor="@color/spirit_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/editGyro_textView_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textColor="@color/spirit_lime"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.kdt.CustomSeekbar
            android:id="@+id/editGyro_seekbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:min="@integer/gyro_speed_seekbar_min"
            android:max="@integer/gyro_speed_seekbar_max"
            app:seekBarIncrement="@integer/gyro_speed_seekbar_increment"
            />
    </LinearLayout>

</LinearLayout>
