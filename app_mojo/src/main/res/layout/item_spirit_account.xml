<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/spirit_account_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/spirit_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/spirit_account_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/spirit_icon_tile"
        android:contentDescription="@null"
        android:padding="3dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/spirit_account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/spirit_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spirit_account_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/spirit_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/spirit_account_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="9dp"
    android:paddingEnd="9dp"
        android:paddingTop="4dp"
    android:paddingBottom="4dp"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
