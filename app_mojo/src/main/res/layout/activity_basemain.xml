<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_height="match_parent"
	android:layout_width="match_parent"
	android:layout_alignParentRight="true"
	android:id="@+id/main_drawer_options"
	android:background="@drawable/no_focus_shown"
	android:keepScreenOn="true">

	<FrameLayout
		android:id="@+id/content_frame"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<git.artdeell.mojo.input.ControlLayout
			android:id="@+id/main_control_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<git.artdeell.mojo.game.GameView
				android:id="@+id/main_game_render_view"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:defaultFocusHighlightEnabled="false"
				android:focusable="true"
				android:descendantFocusability="blocksDescendants"
                tools:ignore="UnusedAttribute">

				<git.artdeell.mojo.game.GameCursorView
					android:layout_height="match_parent"
					android:layout_width="match_parent"
					android:orientation="vertical"
					android:id="@+id/main_cursorview"
					android:focusable="false"
					android:translationZ="1dp"
					android:visibility="gone"
					app:defaultCursorDrawable="@drawable/ic_mouse_pointer"/>

			</git.artdeell.mojo.game.GameView>


			<git.artdeell.mojo.input.keyboard.TouchCharInput
				android:id="@+id/mainTouchCharInput"
				android:layout_width="1dp"
				android:layout_height="1dp"
				android:background="@android:color/darker_gray"
				android:ems="10"
				android:imeOptions="flagNoFullscreen|flagNoExtractUi|flagNoPersonalizedLearning|actionDone"
				android:inputType="textFilter|textImeMultiLine|textAutoComplete|textAutoCorrect"
				tools:ignore="TouchTargetSizeCheck" />

			<git.artdeell.mojo.input.handleview.DrawerPullButton
				android:id="@+id/drawer_button"
				android:layout_width="40dp"
				android:layout_height="20dp"
				android:padding="8dp"
				android:elevation="10dp"
				android:layout_gravity="center_horizontal"/>
			<git.artdeell.mojo.input.mouse.HotbarView
				android:id="@+id/hotbar_view"
				android:layout_width="0px"
				android:layout_height="0px"/>

		</git.artdeell.mojo.input.ControlLayout>

		<FrameLayout
			android:id="@+id/main_loading_screen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#050604"
			android:visibility="visible">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:gravity="center"
				android:orientation="vertical">

				<ImageView
					android:layout_width="84dp"
					android:layout_height="84dp"
					android:src="@mipmap/ic_spirit"
					android:contentDescription="@null" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:text="@string/spirit_loading_brand"
					android:textColor="#F2F7EA"
					android:textSize="18sp"
					android:textStyle="bold"
					android:letterSpacing="0.2" />

				<TextView
					android:id="@+id/main_loading_screen_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:text="@string/spirit_loading_starting"
					android:textColor="@color/spirit_lime"
					android:textSize="11sp"
					android:textStyle="bold"
					android:letterSpacing="0.15" />

				<TextView
					android:id="@+id/main_loading_name"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:maxWidth="360dp"
					android:maxLines="1"
					android:ellipsize="end"
					android:textColor="#F2F7EA"
					android:textSize="20sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/main_loading_version"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:maxWidth="360dp"
					android:maxLines="1"
					android:ellipsize="end"
					android:textColor="#B4BFAB"
					android:textSize="13sp" />

				<ProgressBar
					android:id="@+id/main_loading_screen_progress"
					style="?android:attr/progressBarStyleHorizontal"
					android:layout_width="240dp"
					android:layout_height="6dp"
					android:layout_marginTop="14dp"
					android:indeterminate="true"
					android:indeterminateTint="@color/spirit_lime" />

				<TextView
					android:id="@+id/main_loading_screen_warning"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:text="@string/loading_screen_warning"
					android:textColor="#9FAB96"
					android:textSize="12sp" />
			</LinearLayout>
		</FrameLayout>

		<com.kdt.LoggerView
			android:id="@+id/mainLoggerView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"
			/>

	</FrameLayout>

	<ListView
		android:layout_width="200dp"
		android:layout_height="match_parent"
		android:layout_gravity="right"
		android:background="@color/background_status_bar"
		android:divider="@color/spirit_card_stroke"
		android:dividerHeight="1dp"
		android:fitsSystemWindows="false"
		android:id="@+id/main_navigation_view"/>

</androidx.drawerlayout.widget.DrawerLayout>

